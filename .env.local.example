# Copy this file to .env.local and fill in the values.

# --- Read-only reference database shipped by Kognivera (data/PS-04.db) ---
# Path is relative to the project root. You shouldn't need to change this
# unless you moved the file.
CATALOG_DB_PATH=./data/PS-04.db

# --- Additive app database PackagePro creates itself (sessions, saved
# customisations, guide selections, share links, bookings). Created
# automatically on first run / via `npm run db:init`. ---
APP_DB_PATH=./data/app.db

# --- AI package-builder (stretch goal) ---
# Free tier at https://console.groq.com — create an account, generate an
# API key, paste it below. Model used: llama-3.3-70b-versatile.
# The AI builder feature degrades gracefully (rule-based fallback) if this
# is left blank, so it's safe to leave empty until you set it up.
GROQ_API_KEY=

# Base URL used when generating share links. Change for deployment.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
